<mujoco model="single_inverted_pendulum">
    <compiler coordinate="local" inertiafromgeom="true"/>

    <!-- 1. ФИЗИЧЕСКИЕ НАСТРОЙКИ СРЕДЫ -->
    <option gravity="0 0 -9.8156" timestep="0.005" integrator="RK4" density="1.2" viscosity="0.000018">
        <flag energy="enable" clampctrl="enable"/>
    </option>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="100" height="100"/>
        <material name="grid_mat" texture="grid" texrepeat="10 10"/>
    </asset>

    <worldbody>
        <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 .1" material="grid_mat"/>

        <!-- 2. ТЕЛЕЖКА (CART) -->
        <body name="cart" pos="0 0 1.0">
            <geom name="cart_geom" type="box" size="0.1 0.06 0.04" rgba="0.2 0.6 0.2 1" mass="1.0"/>

            <!-- joint slide: линейная степень свободы.
                 range = ±0.25 м (длина рельса 50 см). frictionloss имитирует сухое трение. -->
            <joint name="slider" type="slide" axis="1 0 0" range="-0.25 0.25" limited="true"
                   damping="0.2" frictionloss="0.5"/>

            <!-- 3. ОДНО КОЛЕНО (ОДИНОЧНЫЙ МАЯТНИК) -->
            <!-- Тело pole висит от тележки; θ = 0 → колено смотрит вверх, θ = π → вниз. -->
            <body name="pole" pos="0 0 0">
                <!-- Род (20 см), масса ~0.1 кг -->
                <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.2" size="0.015" rgba="0.2 0.8 0.2 1" mass="0.1"/>
                <joint name="hinge1" type="hinge" axis="0 1 0" damping="0.01" frictionloss="0.02"/>

                <!-- 4. ГРУЗИК НА КОНЦЕ КОЛЕНА (малая масса, масса ~0.05 кг) -->
                <geom name="tip_geom" type="sphere" pos="0 0 0.2" size="0.03" rgba="0.9 0.2 0.1 1" mass="0.05"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="cart_motor" joint="slider" gear="1" ctrlrange="-15 15" ctrllimited="true"/>
    </actuator>
</mujoco>
